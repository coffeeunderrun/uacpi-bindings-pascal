      8: (address64: Tuacpi_resource_address64);
      9: (address64_extended: Tuacpi_resource_address64_extended);
      10: (memory24: Tuacpi_resource_memory24);
      11: (memory32: Tuacpi_resource_memory32);
      12: (fixed_memory32: Tuacpi_resource_fixed_memory32);
      13: (start_dependent: Tuacpi_resource_start_dependent);
      14: (vendor: Tuacpi_resource_vendor);
      15: (vendor_typed: Tuacpi_resource_vendor_typed);
      16: (generic_register: Tuacpi_resource_generic_register);
      17: (gpio_connection: Tuacpi_resource_gpio_connection);
      18: (serial_bus_common: Tuacpi_resource_serial_bus_common);
      19: (i2c_connection: Tuacpi_resource_i2c_connection);
      20: (spi_connection: Tuacpi_resource_spi_connection);
      21: (uart_connection: Tuacpi_resource_uart_connection);
      22: (csi2_connection: Tuacpi_resource_csi2_connection);
      23: (pin_function: Tuacpi_resource_pin_function);
      24: (pin_configuration: Tuacpi_resource_pin_configuration);
      25: (pin_group: Tuacpi_resource_pin_group);
      26: (pin_group_function: Tuacpi_resource_pin_group_function);
      27: (pin_group_configuration: Tuacpi_resource_pin_group_configuration);
      28: (clock_input: Tuacpi_resource_clock_input);
    end;
  end;

  Puacpi_resources = ^Tuacpi_resources;
  Tuacpi_resources = record
    (*
     * Length of the 'entries' array in BYTES (NOT the count of resources),
     * see comment above 'entries' for more information.
     *)
    length: Tuacpi_size;

    (*
     * Resources are variable length! See UACPI_NEXT_RESOURCE to see how to
     * retrieve the next resource. You can alternatively use
     * uacpi_for_each_resource instead of iterating manually.
     *
     * Resources are guaranteed to be naturally aligned and are always
     * terminated by a resource of type UACPI_RESOURCE_TYPE_END_TAG.
     *)
    entries: Puacpi_resource;
  end;

procedure uacpi_free_resources(resources: Tuacpi_resources); cdecl; external;

type
  Tuacpi_resource_iteration_callback = function(user: Pointer; resource: Puacpi_resource): Tuacpi_iteration_decision; cdecl;

(*
 * Evaluate the _CRS method for a 'device' and get the returned resource list
 * via 'out_resources'.
 *
 * NOTE: the returned buffer must be released via uacpi_free_resources()
 *
 * If you don't need to keep the resource array for later use you can
 * uacpi_for_each_device_resource(device, "_CRS", ...) instead, which takes
 * care of iteration & memory management on its own.
 *)
function uacpi_get_current_resources(
    device: Puacpi_namespace_node; out out_resources: Puacpi_resources
): Tuacpi_status; cdecl; external;

(*
 * Evaluate the _PRS method for a 'device' and get the returned resource list
 * via 'out_resources'.
 *
 * NOTE: the returned buffer must be released via uacpi_free_resources()
 *
 * If you don't need to keep the resource array for later use you can
 * uacpi_for_each_device_resource(device, "_PRS", ...) instead, which takes
 * care of iteration & memory management on its own.
 *)
function uacpi_get_possible_resources(
    device: Puacpi_namespace_node; out out_resources: Puacpi_resources
): Tuacpi_status; cdecl; external;

(*
 * Evaluate an arbitrary method that is expected to return an AML resource
 * buffer for a 'device' and get the returned resource list via 'out_resources'.
 *
 * NOTE: the returned buffer must be released via uacpi_free_resources()
 *
 * If you don't need to keep the resource array for later use you can
 * uacpi_for_each_device_resource(device, method, ...) instead, which takes
 * care of iteration & memory management on its own.
 *)
function uacpi_get_device_resources(
    device: Puacpi_namespace_node;
    const method: Puacpi_char;
    out out_resources: Puacpi_resources
): Tuacpi_status; cdecl; external;

(*
 * Set the configuration to be used by the 'device' by calling its _SRS method.
 *
 * Note that this expects 'resources' in the normal 'uacpi_resources' format,
 * and not the raw AML resources bytestream, the conversion to the latter is
 * done automatically by this API. If you want to _SRS a raw AML resources
 * bytestream, use 'uacpi_execute' or similar API directly.
 *)
function uacpi_set_resources(
    device: Puacpi_namespace_node; resources: Puacpi_resources
): Tuacpi_status; cdecl; external;

(*
 * A convenience helper for iterating over the resource list returned by any
 * of the uacpi_get_*_resources functions.
 *)
function uacpi_for_each_resource(
    resources: Puacpi_resources; cb: Tuacpi_resource_iteration_callback; user: Pointer
): Tuacpi_status; cdecl; external;

(*
 * A shorthand for uacpi_get_device_resources() + uacpi_for_each_resource().
 *
 * Use if you don't actually want to save the 'resources' list, but simply want
 * to iterate it once to extract the resources you care about and then free it
 * right away.
 *)
function uacpi_for_each_device_resource(
    device: Puacpi_namespace_node; const method: Puacpi_char;
    cb: Tuacpi_resource_iteration_callback; user: Pointer
): Tuacpi_status; cdecl; external;

(*
 * Convert a single AML-encoded resource to native format.
 *
 * This should be used for converting Connection() fields (passed during IO on
 * GeneralPurposeIO or GenericSerialBus operation regions) or other similar
 * buffers with only one resource to native format.
 *
 * NOTE: the returned buffer must be released via uacpi_free_resource()
 *)
function uacpi_get_resource_from_buffer(
    aml_buffer: Tuacpi_data_view; out out_resource: Puacpi_resource
): Tuacpi_status; cdecl; external;

procedure uacpi_free_resource(resource: Puacpi_resource); cdecl; external;

